{
  "name": "Intelligence Business Support",
  "dataColors": [
    "#C5A028",
    "#FFFFFF",
    "#6B6B6B",
    "#E8D080",
    "#A08020",
    "#4A4A4A",
    "#D4C060",
    "#808080"
  ],
  "good": "#4CAF82",
  "neutral": "#C5A028",
  "bad": "#E05C5C",
  "maximum": "#C5A028",
  "center": "#D4C060",
  "minimum": "#E05C5C",
  "null": "#4A4A4A",
  "background": "#1E1E1E",
  "foreground": "#F2F2F2",
  "tableAccent": "#C5A028",
  "textClasses": {
    "callout": {
      "fontSize": 45,
      "fontFace": "Segoe UI",
      "color": "#FFFFFF"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI",
      "color": "#C5A028"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI",
      "color": "#FFFFFF"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#AAAAAA"
    },
    "largeTitle": {
      "fontSize": 28,
      "fontFace": "Segoe UI",
      "color": "#FFFFFF"
    },
    "smallLabel": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#888888"
    },
    "semiboldLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#AAAAAA"
    },
    "boldLabel": {
      "fontSize": 10,
      "fontFace": "Segoe UI Bold",
      "color": "#CCCCCC"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": false }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#CCCCCC" } },
          "background": { "solid": { "color": "#2A2A2A" } },
          "fontSize": 11,
          "fontFamily": "Segoe UI"
        }]
      }
    },
    "card": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F2F2F2" } }, "transparency": 0 }],
        "calloutValue": [{
          "fontSize": 36,
          "fontFamily": "Segoe UI",
          "labelDisplayUnits": 0
        }],
        "categoryLabel": [{
          "show": true,
          "fontSize": 11,
          "fontFamily": "Segoe UI",
          "color": { "solid": { "color": "#555555" } }
        }],
        "title": [{ "show": false }],
        "border": [{ "show": false }]
      }
    },
    "multiRowCard": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F2F2F2" } }, "transparency": 0 }],
        "dataLabels": [{
          "color": { "solid": { "color": "#333333" } },
          "fontSize": 13,
          "fontFamily": "Segoe UI"
        }],
        "categoryLabels": [{
          "show": true,
          "color": { "solid": { "color": "#666666" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "title": [{ "show": false }]
      }
    },
    "lineChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "legend": [{
          "show": true,
          "fontColor": { "solid": { "color": "#AAAAAA" } },
          "fontSize": 9
        }],
        "categoryAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#888888" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#3A3A3A" } }
        }],
        "valueAxis": [{
          "show": true,
          "labelColor": { "solid": { "color": "#888888" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#3A3A3A" } }
        }],
        "dataPoint": [{
          "defaultColor": { "solid": { "color": "#C5A028" } }
        }],
        "title": [{
          "show": true,
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 12,
          "fontFamily": "Segoe UI"
        }]
      }
    },
    "barChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#AAAAAA" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#3A3A3A" } }
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#AAAAAA" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#3A3A3A" } }
        }],
        "dataPoint": [{
          "defaultColor": { "solid": { "color": "#C5A028" } }
        }],
        "dataLabels": [{
          "show": true,
          "color": { "solid": { "color": "#CCCCCC" } },
          "fontSize": 9
        }],
        "title": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 12
        }]
      }
    },
    "clusteredBarChart": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "dataPoint": [{
          "defaultColor": { "solid": { "color": "#C5A028" } }
        }],
        "categoryAxis": [{
          "labelColor": { "solid": { "color": "#AAAAAA" } },
          "fontSize": 9
        }],
        "valueAxis": [{
          "labelColor": { "solid": { "color": "#AAAAAA" } },
          "fontSize": 9,
          "gridlineColor": { "solid": { "color": "#3A3A3A" } }
        }],
        "dataLabels": [{
          "show": true,
          "color": { "solid": { "color": "#CCCCCC" } },
          "fontSize": 9
        }]
      }
    },
    "tableEx": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "header": [{
          "fontColor": { "solid": { "color": "#CCCCCC" } },
          "background": { "solid": { "color": "#1E1E1E" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#EEEEEE" } },
          "backgroundPrimary": { "solid": { "color": "#2A2A2A" } },
          "fontColorSecondary": { "solid": { "color": "#CCCCCC" } },
          "backgroundSecondary": { "solid": { "color": "#252525" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "totals": [{
          "fontColor": { "solid": { "color": "#C5A028" } },
          "background": { "solid": { "color": "#1E1E1E" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI Bold"
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontalColor": { "solid": { "color": "#3A3A3A" } },
          "rowPadding": 4
        }],
        "title": [{
          "fontColor": { "solid": { "color": "#FFFFFF" } },
          "fontSize": 12
        }]
      }
    },
    "matrix": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "columnHeaders": [{
          "fontColor": { "solid": { "color": "#CCCCCC" } },
          "background": { "solid": { "color": "#1E1E1E" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "rowHeaders": [{
          "fontColor": { "solid": { "color": "#CCCCCC" } },
          "background": { "solid": { "color": "#1E1E1E" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "values": [{
          "fontColorPrimary": { "solid": { "color": "#EEEEEE" } },
          "backgroundPrimary": { "solid": { "color": "#2A2A2A" } },
          "fontColorSecondary": { "solid": { "color": "#CCCCCC" } },
          "backgroundSecondary": { "solid": { "color": "#252525" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "subtotals": [{
          "fontColor": { "solid": { "color": "#C5A028" } },
          "background": { "solid": { "color": "#1E1E1E" } },
          "fontSize": 10
        }],
        "grid": [{
          "gridVertical": false,
          "gridHorizontalColor": { "solid": { "color": "#3A3A3A" } },
          "rowPadding": 3
        }]
      }
    },
    "slicer": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "data": [{
          "fontColor": { "solid": { "color": "#CCCCCC" } },
          "background": { "solid": { "color": "#2A2A2A" } },
          "fontSize": 10,
          "fontFamily": "Segoe UI"
        }],
        "header": [{
          "show": true,
          "fontColor": { "solid": { "color": "#AAAAAA" } },
          "background": { "solid": { "color": "#2A2A2A" } },
          "fontSize": 10
        }],
        "selection": [{
          "selectAllCheckboxEnabled": false
        }],
        "title": [{ "show": false }]
      }
    },
    "textbox": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "border": [{ "show": false }]
      }
    },
    "shape": {
      "*": {
        "fill": [{ "color": { "solid": { "color": "#2A2A2A" } }, "transparency": 0 }],
        "line": [{ "color": { "solid": { "color": "#3A3A3A" } }, "transparency": 0 }]
      }
    },
    "actionButton": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#2A2A2A" } } }],
        "border": [{
          "show": true,
          "color": { "solid": { "color": "#C5A028" } }
        }],
        "text": [{
          "fontColor": { "solid": { "color": "#C5A028" } },
          "fontSize": 11,
          "fontFamily": "Segoe UI"
        }]
      }
    }
  }
}
